# Copy to .env and fill in. The real .env is never committed.
#
# Nothing loads this file automatically yet: Docker Compose will read it once
# the compose environment exists (M1). Until then, export variables in your
# shell if you need to override a default.

# Which settings module Django loads: development, testing or production.
DJANGO_SETTINGS_MODULE=config.settings.development

# Required in production. Development and testing fall back to an insecure
# built-in value when this is unset.
DJANGO_SECRET_KEY=

# Comma-separated hostnames the site is served from. Production only.
DJANGO_ALLOWED_HOSTS=
