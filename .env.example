# Copy to .env (or run `task setup`) and adjust. The real .env is never committed.
# Docker Compose reads .env from this directory automatically.

# --- Development (compose) ---

# Password for the `sa` account of the development SQL Server container.
# SQL Server requires 8+ characters mixing upper case, lower case, digits and
# symbols. This default is only for the local throwaway database.
MSSQL_SA_PASSWORD=Dev_Passw0rd!

# --- Backend ---
# compose.yml sets the development values of these; they are listed here as
# the reference for what the backend reads.

# Which settings module Django loads: development, testing or production.
# DJANGO_SETTINGS_MODULE=config.settings.development

# Required in production. Development and testing use a built-in value.
# DJANGO_SECRET_KEY=

# Comma-separated hostnames the site is served from. Production only.
# DJANGO_ALLOWED_HOSTS=

# SQL Server connection, shared by the platform and parts databases.
# MSSQL_HOST=localhost
# MSSQL_PORT=1433
# MSSQL_USER=
# MSSQL_PASSWORD=
# Extra ODBC connection string parameters, e.g. TrustServerCertificate=yes
# MSSQL_EXTRA_PARAMS=

# Database names on that server.
# PLATFORM_DB_NAME=ee_platform
# PARTS_DB_NAME=ee_parts
